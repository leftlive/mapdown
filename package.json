{
  "name": "mapdown",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Edit any Markdown note as a mind map in Obsidian.",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "NODE_OPTIONS=--max-old-space-size=2048 node --test --test-concurrency=4 --test-timeout=60000 \"tests/unit/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "e2e": "node tests/e2e.cjs"
  },
  "dependencies": {
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "25.9.9",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
